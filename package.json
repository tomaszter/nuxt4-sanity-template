{
   "name": "nuxt4-sanity-template-web",
   "private": true,
   "scripts": {
      "dev": "yarn workspaces foreach --all --parallel run dev",
      "dev:app": "yarn workspace nuxt4-sanity-template-app run dev",
      "dev:studio": "yarn workspace nuxt4-sanity-template-studio run dev",
      "extract-types": "yarn workspace nuxt4-sanity-template-studio run extract-types",
      "typegen": "yarn workspace nuxt4-sanity-template-studio run typegen",
      "typecheck": "yarn workspaces foreach --all run typecheck",
      "lint": "yarn workspaces foreach --all run lint",
      "build": "yarn workspaces foreach --all run build"
   },
   "keywords": [
      "Sanity",
      "Nuxt",
      "Headless CMS",
      "Visual Editing",
      "Live Content API (LCAPI)",
      "Real-time"
   ],
   "workspaces": [
      "packages/*"
   ],
   "packageManager": "yarn@4.9.4",
   "engines": {
      "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
   }
}
