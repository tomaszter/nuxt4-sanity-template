# Generated by yarn setup. Website name, domains and languages live in Sanity.
NUXT_PUBLIC_SANITY_PROJECT_ID=""
NUXT_PUBLIC_SANITY_DATASET="production"
NUXT_PUBLIC_SANITY_API_VERSION="2025-02-19"
# Enable only for the local/server-side Studio preview, never the static production build.
NUXT_SANITY_PREVIEW="true"
NUXT_SANITY_VISUAL_EDITING_STUDIO_URL="http://localhost:3333"
# Private, read-only viewer token. Never use a NUXT_PUBLIC_ prefix.
NUXT_SANITY_VISUAL_EDITING_TOKEN=""
# Optional; disabled by default and always disabled in preview.
NUXT_ENABLE_PWA="false"
